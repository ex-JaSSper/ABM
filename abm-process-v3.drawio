        <mxCell id="1" parent="0" />

        <mxCell id="tA" value="① Процесс по компании — двигает воронку и метрики" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="700" height="26" as="geometry" /></mxCell>

        <mxCell id="A_start" value="Данные загружены" style="shape=mxgraph.bpmn.shape;perimeter=ellipsePerimeter;html=1;verticalLabelPosition=bottom;verticalAlign=top;outline=standard;symbol=general;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="46" height="46" as="geometry" /></mxCell>
        <mxCell id="A_sig" value="Сигналы: все компании (авто)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="120" y="170" width="160" height="66" as="geometry" /></mxCell>
        <mxCell id="A_fit" value="Подходит?" style="shape=mxgraph.bpmn.gateway2;html=1;verticalLabelPosition=top;verticalAlign=bottom;outline=standard;symbol=exclusiveGw;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="320" y="170" width="66" height="66" as="geometry" /></mxCell>
        <mxCell id="A_reject" value="Отклонён" style="shape=mxgraph.bpmn.shape;perimeter=ellipsePerimeter;html=1;verticalLabelPosition=bottom;verticalAlign=top;outline=end;symbol=general;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="332" y="70" width="42" height="42" as="geometry" /></mxCell>
        <mxCell id="A_note_chekko" value="Отвес ручной (вчитались). Chekko / благонадёжность — бэклог." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="250" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="A_work" value="«В работу» → авто-задача «Разобрать сигнал» (статус: Отобрано)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="165" width="180" height="76" as="geometry" /></mxCell>
        <mxCell id="A_analyze" value="Разобрать сигнал → определить предложение (описываем сами)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="650" y="170" width="170" height="66" as="geometry" /></mxCell>
        <mxCell id="A_close1" value="Закрыть: предложение готово → следующий шаг" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="860" y="170" width="170" height="66" as="geometry" /></mxCell>
        <mxCell id="A_next" value="Назначить следующий шаг + выбрать ТИП: касание / повт. касание / встреча / повт. встреча / договорённость" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1070" y="160" width="200" height="86" as="geometry" /></mxCell>
        <mxCell id="A_do" value="Выполнить шаг → задача ждёт ответа" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1310" y="170" width="160" height="66" as="geometry" /></mxCell>
        <mxCell id="A_close2" value="Завершить задачу → +1 к метрике выбранного типа; двигаем статус компании" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1510" y="165" width="190" height="76" as="geometry" /></mxCell>
