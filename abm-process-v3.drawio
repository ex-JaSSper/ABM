        <mxCell id="A_rev" value="Продажа / выручка" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="2060" y="170" width="140" height="66" as="geometry" /></mxCell>
