        <mxCell id="tB" value="② Плоскость гипотез — отдельно от задач по компании (прогресс вручную ☑)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="820" height="26" as="geometry" /></mxCell>
        <mxCell id="B_hyp" value="Гипотеза: «продукт X понравится компании / сегменту Y»" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="B_task" value="Задача: предложить продукт X" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e9dff0;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="340" y="440" width="180" height="50" as="geometry" /></mxCell>
        <mxCell id="B_sub" value="Подзадачи (☑ вручную):&#10;☑ касание 1&#10;☑ касание 2&#10;☐ …&#10;☐ касание 10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f2ecf7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="420" width="200" height="100" as="geometry" /></mxCell>
        <mxCell id="B_prog" value="Прогресс задачи → прогресс-бар гипотезы" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="820" y="440" width="190" height="50" as="geometry" /></mxCell>
        <mxCell id="B_note" value="Галочка в подзадаче двигает прогресс задачи и гипотезы. Эти касания отмечаем вручную — отдельно от авто-метрик из процесса ①." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="425" width="230" height="90" as="geometry" /></mxCell>
