        <mxCell id="b2" style="html=1;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="B_task" target="B_sub"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b3" style="html=1;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="B_sub" target="B_prog"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="tC" value="③ Главная — две агрегации" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="500" height="26" as="geometry" /></mxCell>

        <mxCell id="C_metrics" value="Метрики — счётчики, +1 при завершении задачи по её типу (повторные считаются):&#10;&#10;•  Новые касания (первое сообщение)&#10;•  Повторные касания&#10;•  Новые встречи (проявленный интерес)&#10;•  Повторные встречи&#10;•  Выход на договорённости (договор / пилот)&#10;•  Выручка" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="360" height="220" as="geometry" /></mxCell>

        <mxCell id="C_ftitle" value="Воронка — уникальные клиенты, без повторов" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=2;fontSize=12;fontColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="470" y="650" width="400" height="22" as="geometry" /></mxCell>
        <mxCell id="fu1" value="Выгружено&#10;все из таблицы" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1f0f0;strokeColor=#0e8088;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="690" width="130" height="60" as="geometry" /></mxCell>
        <mxCell id="fu2" value="Перенесено в разбор&#10;взято в работу" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#c2e4e4;strokeColor=#0e8088;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="690" width="130" height="60" as="geometry" /></mxCell>
        <mxCell id="fu3" value="Касание&#10;уникальные клиенты" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#9ed6d6;strokeColor=#0e8088;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="690" width="130" height="60" as="geometry" /></mxCell>
        <mxCell id="fu4" value="Встреча&#10;уникальные клиенты" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#6bc0c0;strokeColor=#0e8088;fontSize=11;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="920" y="690" width="130" height="60" as="geometry" /></mxCell>
