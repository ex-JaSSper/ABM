        <mxCell id="a12" value="исключить" style="html=1;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="A_gw" target="A_out"><mxGeometry relative="1" as="geometry" /></mxCell>
